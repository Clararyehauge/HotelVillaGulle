---
import Heading from "./Heading.astro";
import Text from "./Text.astro";

interface Props {
  title: string;
  leftImage: string;
  leftImageAlt: string;
  rightImage: string;
  rightImageAlt: string;
  content: string;
  subtitle?: string;
  rightImageClasses?: string;
}

const { title, leftImage, leftImageAlt, rightImage, rightImageAlt, content, subtitle = "Villa Gulle", rightImageClasses = "w-48 md:w-64" } = Astro.props;
---

<section class="w-full bg-sektion-blue pb-4 md:pb-0">
  <div class="flex flex-col lg:flex-row h-[67dvh] md:h-[85dvh] lg:h-[95dvh]">
    {/* Billede til venstre - skjult på mobil */}
    <div class="hidden lg:block lg:w-1/2 overflow-hidden">
      <img src={leftImage} alt={leftImageAlt} class="w-full h-full object-cover object-bottom" />
    </div>

    {/* Indhold */}
    <div class="lg:w-1/2 flex flex-col justify-center items-center px-8 py-10 lg:px-12 lg:py-16">
      <div class="w-full max-w-sm flex flex-col items-center">
        {/* mb-4 på mobil, md:mb-2 på desktop — genskaber den gap der forsvandt */}
        <Heading htmlheading="h1" size="xlarge" font="display" stylingclasses="mb-4 md:mb-2 text-center font-light w-full">
          {title}
        </Heading>

        {/* Illustration */}
        <div class={`mb-4 md:mb-3 ${rightImageClasses}`}>
          <img src={rightImage} alt={rightImageAlt} class="w-full h-auto object-contain" />
        </div>

        <Text teksttype="brødtekst" stylingclasses="mb-6 text-center font-light">
          {content}
        </Text>

        <Text teksttype="signatur" stylingclasses="text-center">
          {subtitle}
        </Text>
      </div>
    </div>
  </div>
</section>
