---
import MainLayout from "../layouts/MainLayout.astro";
import StepIndicator from "../components/Booking/StepIndicator.astro";
import Heading from "../components/Heading.astro";
import BookingSummaryStep3 from "../components/Booking/BookingSummaryStep3.astro";
import GuestDetailsForm from "../components/Booking/GuestDetailsForm.astro";

const url = "https://egxoxtzgworkaghvxrbv.supabase.co/rest/v1/rooms?select=*";
const key = "sb_publishable_dzoaD8ZHxR8hKpgA_C6b0A_lNV1xVMu";

const res = await fetch(url, { headers: { apikey: key } });
const rooms = await res.json();
---

<MainLayout title="Betaling">
  <main class="page-container py-10 md:py-12">
    <a id="back-btn" href="/book_step2" class="absolute left-4 top-10 z-20 inline-flex items-center justify-center md:left-15 md:top-40" aria-label="Tilbage">
      <img src="/icons/back-sort.svg" alt="Tilbage" class="h-6 w-6 md:h-8 md:w-8 transition-transform duration-300 hover:-translate-y-1" />
    </a>

    <StepIndicator currentStep={3} />

    <Heading htmlheading="h2" size="large" font="display" stylingclasses="mb-8 text-center"> Dine detaljer & betaling </Heading>

    <section class="grid grid-cols-1 gap-6 items-start md:grid-cols-[5fr_7fr] md:gap-40">
      <aside class="relative top-0 md:sticky md:top-8">
        <BookingSummaryStep3 rooms={rooms} />
      </aside>
      <div>
        <GuestDetailsForm rooms={rooms} />
      </div>
    </section>
  </main>
  <script>
    const params = new URLSearchParams(window.location.search);
    document.getElementById("back-btn").href = `/book_step2?${params.toString()}`;
  </script>
</MainLayout>
