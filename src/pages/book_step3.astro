---
import MainLayout from "../layouts/MainLayout.astro";
import StepIndicator from "../components/Booking/StepIndicator.astro";
import Heading from "../components/Heading.astro";
import BookingSummaryStep3 from "../components/Booking/BookingSummaryStep3.astro";
import GuestDetailsForm from "../components/Booking/GuestDetailsForm.astro";

const url = "https://egxoxtzgworkaghvxrbv.supabase.co/rest/v1/rooms?select=*";
const key = "sb_publishable_dzoaD8ZHxR8hKpgA_C6b0A_lNV1xVMu";

const res = await fetch(url, { headers: { apikey: key } });
const rooms = await res.json();
---

<MainLayout title="Betaling">
  <main class="page-container py-10 md:py-12">
    <a href="/book_step2" class="absolute left-4 top-10 z-20 inline-flex items-center justify-center md:left-15 md:top-40" aria-label="Tilbage">
      <img src="/icons/back-sort.svg" alt="Tilbage" class="h-6 w-6 md:h-8 md:w-8" />
    </a>
    <StepIndicator currentStep={3} />

    <Heading htmlheading="h2" size="large" font="display" stylingclasses="mb-8 text-center"> Dine detaljer & betaling </Heading>

    <section class="step3-layout">
      <aside class="summary-side">
        <BookingSummaryStep3 rooms={rooms} />
      </aside>
      <div>
        <GuestDetailsForm rooms={rooms} />
      </div>
    </section>
  </main>
</MainLayout>

<style>
  .step3-layout {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: 10rem;
    align-items: start;
  }

  .summary-side {
    position: sticky;
    top: 2rem;
  }

  @media (max-width: 768px) {
    .step3-layout {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .summary-side {
      position: relative;
      top: 0;
    }
  }

  .summary-side {
    position: sticky;
    top: 2rem;
  }

  @media (max-width: 768px) {
    .step3-layout {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .summary-side {
      position: relative;
      top: 0;
    }
  }
</style>
