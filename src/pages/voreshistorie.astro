---
import MainLayout from "../layouts/MainLayout.astro";
import Heading from "../components/Heading.astro";
import Text from "../components/Text.astro";
import HeroPages from "../components/HeroPages.astro";
---

<MainLayout title="Vores historie">
  <HeroPages title="Vores historie" leftImage="/om_hero.png" leftImageAlt="Villa Gulle facade" rightImage="/Sort_logo_2.svg" rightImageAlt="Villa Gulle tegning" content="Vi er mere end et sted at sove - vi er et sted, hvor gode minder skabes. Hotellet er drevet af et passioneret team, der hver dag sætter en ære i at byde dig velkommen. Her kan du læse lidt mere om, hvem vi er og hvad vi står for." subtitle="Villa Gulle" />

  <main class="flex flex-col gap-15 md:gap-20">
    <!-- NY BEGYNDELSE -->
    <section class="page-container grid md:grid-cols-2 items-center mt-15 md:mt-20">
      <div class="order-1 md:order-2 w-full md:max-w-127">
        <Heading htmlheading="h2" size="large" font="display" stylingclasses="mb-8"> En ny begyndelse med respekt for arven </Heading>
        <Text teksttype="brødtekst">I 2021 overtog vi, familien Kongsmark, nøglerne til Hotel Villa Gulle. Vores drøm var klar: Vi ville forandre for at bevare.</Text>
        <Text teksttype="brødtekst">Efter en nænsom og gennemgribende renovering genåbnede vi hotellet i sommeren 2022. Hver en farve, hvert et møbel og hver en detalje er valgt med dyb respekt for bygningens historiske sjæl – og ikke mindst i Gudruns varme ånd.</Text>
        <Text teksttype="brødtekst">I dag er Hotel Villa Gulle et moderne frirum, hvor fortidens charme møder nutidens komfort. Et sted, hvor det gode værtskab og den personlige atmosfære stadig sidder i væggene.</Text>
        <Text teksttype="brødtekst">Vi glæder os til at byde dig velkommen hjem.</Text>
      </div>
      <div class="flex justify-center order-2 md:order-1">
        <img src="/sort_hvid_af_hotel.png" class="w-80 h-auto md:w-100" alt="Sort hvid af hotel" />
      </div>
    </section>

    <!-- HISTORIEN BAG — full-bleed -->
    <section class="grid md:grid-cols-2 items-center w-screen relative left-1/2 right-1/2 -translate-x-1/2">
      <!-- TEKSTBOKS — mere padding på mobil -->
      <div class="bg-secondary-beige-100 w-full md:w-210 px-6 py-20 md:pl-40 md:p-20">
        <Heading htmlheading="h2" size="large" font="display" stylingclasses="mb-8"> Historien bag Hotel Villa Gulle </Heading>
        <div class="max-w-125">
          <Text teksttype="brødtekst">Når du træder ind ad døren på Hotel Villa Gulle, træder du ind i et stykke af Nyborgs historie. Vores fundament blev lagt helt tilbage i 1873, da den fynske skibsmægler Hans Friis opførte en storslået klassicistisk villa til sig selv og sin familie. Siden da har bygningerne levet mange liv – fra samlingspunkt for byens borgere i 1920'ernes nybyggede festsal til det lokale missionshotel.</Text>
          <Text teksttype="brødtekst">Det var dog først i 1996, at hotellet fik sit nuværende navn og sin helt særlige personlighed. Her overtog Gudrun Simonsen stedet og døbte det kærligt 'Hotel Villa Gulle' – en sammentrækning af husets oprindelse som villa og hendes eget kaldenavn. I et kvart århundrede drev Gudrun hotellet med et usædvanligt hjerterum, der gjorde det til et elsket byhotel.</Text>
        </div>
      </div>

      <!-- BILLEDER — kortere på mobil, billederne skubbet ned fra toppen -->
      <div class="relative w-full h-80 md:w-150 md:h-150 md:pl-20 mb-6 md:mb-20">
        <img src="/dekoration1.png" class="absolute w-48 object-cover -top-20 left-[55%] md:top-10 md:left-0 md:w-65" alt="" />
        <img src="/dekoration2.png" class="absolute w-48 object-cover -top-11 left-10 md:top-32 md:left-70 md:w-56" alt="" />
        <img src="/dekoration3.png" class="absolute w-48 object-cover top-50 left-[30%] md:top-100 md:left-42 md:w-50" alt="" />
      </div>
    </section>

    <!-- FØR/EFTER -->
    <section class="page-container flex flex-col items-center mt-25 md:mt-0">
      <div class="relative w-full md:max-w-[700px] aspect-[4/3] overflow-hidden select-none" id="compare">
        <img src="/stue_efter.png" class="absolute inset-0 w-full h-full object-cover" alt="Efter renovering" />
        <img src="/stue_foer.png" class="absolute inset-0 w-full h-full object-cover" id="beforeImage" style="clip-path: inset(0 50% 0 0);" alt="Før renovering" />
        <div class="absolute top-0 bottom-0 w-0.5 bg-secondary-beige-100 z-20" id="sliderLine" style="left: 50%; transform: translateX(-50%);"></div>
        <div class="absolute top-1/2 z-30 w-10 h-10 bg-secondary-beige-100 rounded-full cursor-ew-resize flex items-center justify-center" id="handle" style="left: 50%; transform: translate(-50%, -50%);">
          <span>↔</span>
        </div>
      </div>
      <div class="w-full max-w-[700px]">
        <Text teksttype="brødtekst">Se før og efter renovering af hotellets dagligstue.</Text>
      </div>
    </section>

    <!-- BREV — full-bleed baggrundsbillede -->
    <section class="relative py-20">
      <img src="/tapet_baggrund.png" class="absolute inset-0 w-full h-full object-cover z-0" alt="" />
      <div class="relative z-10 bg-primary-Background-50 p-20 w-3/4 md:w-200 mx-auto">
        <Heading htmlheading="h2" size="large" font="display" stylingclasses="mb-10"> Kære gæster på Hotel Villa Gulle, </Heading>
        <Text teksttype="brødtekst" stylingclasses="mb-5">Det glæder mig at byde jer velkommen til et sted, hvor ro og varme mødes. Jeg har skabt dette hotel med ønsket om, at alle skal føle sig hjemme, blot lidt mere forkælet.</Text>
        <Text teksttype="brødtekst">Nyd vores stille kroge, den bløde morgenkaffe og den venlige stemning i hvert rum. Skulle I mangle noget, er min dør altid åben, og jeg lytter gerne.</Text>
        <Heading htmlheading="h5" size="xsmall" font="display" stylingclasses="mt-10"> Med venlig hilsen, Joakim, jeres hotelejer </Heading>
      </div>
    </section>
  </main>
</MainLayout>

<script>
  const container = document.getElementById("compare");
  const beforeImage = document.getElementById("beforeImage");
  const sliderLine = document.getElementById("sliderLine");
  const handle = document.getElementById("handle");

  let isDown = false;

  function setPosition(x) {
    const rect = container.getBoundingClientRect();
    let pos = Math.max(0, Math.min(1, (x - rect.left) / rect.width));
    const percent = pos * 100;
    beforeImage.style.clipPath = `inset(0 ${100 - percent}% 0 0)`;
    sliderLine.style.left = `${percent}%`;
    handle.style.left = `${percent}%`;
  }

  container.addEventListener("mousedown", () => (isDown = true));
  window.addEventListener("mouseup", () => (isDown = false));
  window.addEventListener("mousemove", (e) => {
    if (isDown) setPosition(e.clientX);
  });

  container.addEventListener("touchstart", () => (isDown = true));
  window.addEventListener("touchend", () => (isDown = false));
  window.addEventListener("touchmove", (e) => {
    if (isDown) setPosition(e.touches[0].clientX);
  });
</script>
